<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  
    <!-- ⭐ CRÍTICO: Deshabilita excepciones de navegación (como Sliced_web_app) -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Actualizar ruta: ahora Core está 2 niveles arriba -->
    <ProjectReference Include="..\..\Core\VRM_Plugin.Core.Abstractions\VRM_Plugin.Core.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ❌ ELIMINADO: Paquete obsoleto de .NET Core 2.1 - .NET 8 ya incluye autenticación de cookies -->
    <!-- <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" Version="2.3.0" /> -->
    
    <PackageReference Include="MudBlazor" Version="7.6.0" />
    
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- 🔥 Target para copiar módulos durante BUILD -->
  <Target Name="CopyModulesOnBuild" AfterTargets="Build">
    <Message Text="🏗️ [BUILD] Descubriendo y compilando módulos..." Importance="high" />

    <PropertyGroup>
      <ModulesOutDir>$(OutDir)Modules\</ModulesOutDir>
      <SolutionDir>$(MSBuildProjectDirectory)\..\..\..\</SolutionDir>
    </PropertyGroup>

    <ItemGroup>
      <ModuleProjects Include="$(SolutionDir)src\Modules\**\VRM_Plugin.*.csproj" />
    </ItemGroup>

    <Message Text="📦 Encontrados @(ModuleProjects-&gt;Count()) proyectos de módulos" Importance="high" />

    <MSBuild Projects="@(ModuleProjects)" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform)" BuildInParallel="true" />

    <ItemGroup>
      <OldModuleFiles Include="$(ModulesOutDir)**\*.*" />
    </ItemGroup>
    <Delete Files="@(OldModuleFiles)" ContinueOnError="true" />
    <MakeDir Directories="$(ModulesOutDir)" />

    <ItemGroup>
      <ModuleDlls Include="$(SolutionDir)src\Modules\**\bin\$(Configuration)\net8.0\VRM_Plugin.*.dll" />
      <ModulePdbs Include="$(SolutionDir)src\Modules\**\bin\$(Configuration)\net8.0\VRM_Plugin.*.pdb" />
    </ItemGroup>

    <Copy SourceFiles="@(ModuleDlls)" DestinationFolder="$(ModulesOutDir)" SkipUnchangedFiles="false" />

    <Copy SourceFiles="@(ModulePdbs)" DestinationFolder="$(ModulesOutDir)" SkipUnchangedFiles="false" />

    <Message Text="✅ @(ModuleDlls-&gt;Count()) módulos copiados a $(ModulesOutDir)" Importance="high" />
  </Target>

  <!-- 🔥 Target para copiar módulos durante PUBLISH -->
  <Target Name="CopyModulesOnPublish" AfterTargets="Publish">
    <Message Text="🚀 [PUBLISH] Copiando módulos a la salida de publicación..." Importance="high" />

    <PropertyGroup>
      <SolutionDir>$(MSBuildProjectDirectory)\..\..\..\</SolutionDir>
      <PublishModulesDir>$(PublishDir)Modules\</PublishModulesDir>
    </PropertyGroup>

    <!-- Compilar módulos si no están compilados -->
    <ItemGroup>
      <ModuleProjects Include="$(SolutionDir)src\Modules\**\VRM_Plugin.*.csproj" />
    </ItemGroup>

    <Message Text="📦 Compilando @(ModuleProjects-&gt;Count()) módulos para publicación..." Importance="high" />

    <MSBuild Projects="@(ModuleProjects)" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform)" BuildInParallel="true" />

    <!-- Crear carpeta Modules en la salida de publicación -->
    <MakeDir Directories="$(PublishModulesDir)" />

    <!-- Buscar y copiar DLLs y PDBs de módulos -->
    <ItemGroup>
      <ModuleDlls Include="$(SolutionDir)src\Modules\**\bin\$(Configuration)\net8.0\VRM_Plugin.*.dll" />
      <ModulePdbs Include="$(SolutionDir)src\Modules\**\bin\$(Configuration)\net8.0\VRM_Plugin.*.pdb" />
    </ItemGroup>

    <Message Text="📋 Archivos a copiar:" Importance="high" />
    <Message Text="   @(ModuleDlls)" Importance="high" />

    <Copy SourceFiles="@(ModuleDlls)" DestinationFolder="$(PublishModulesDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />

    <Copy SourceFiles="@(ModulePdbs)" DestinationFolder="$(PublishModulesDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />

    <Message Text="✅ @(ModuleDlls-&gt;Count()) módulos copiados a $(PublishModulesDir)" Importance="high" />
  </Target>
  
</Project>
