@page "/login"
@* ⚠️ SSR ESTÁTICO - Login NO usa InteractiveServer para soportar cookies HTTP *@
@* El formulario necesita un POST HTTP real para que SignInAsync pueda escribir cookies *@
@using VRM_PluginDemo.Blazor.Server.Components.Layout
@layout AuthLayout
@using Microsoft.AspNetCore.Components.Authorization
@using VRM_PluginDemo.Blazor.Server.Services
@using System.ComponentModel.DataAnnotations
@inject DummyAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Sign In - VRM</PageTitle>

<!-- Login Page - UI de Sliced integrada con autenticación VRM -->
<div class="min-h-[calc(100vh-134px)] py-4 px-4 sm:px-12 flex justify-center items-center max-w-[1440px] mx-auto">
<div class="max-w-[550px] flex-none w-full bg-white border border-black/10 p-6 sm:p-10 lg:px-10 lg:py-14 rounded-2xl loginform dark:bg-darklight dark:border-darkborder">
    
 <!-- Título -->
   <MudText Typo="Typo.h1" Class="mb-2 text-2xl font-semibold text-center dark:text-white">
 Sign In to VRM
  </MudText>
 <MudText Class="text-center text-muted mb-7 dark:text-darkmuted">
    Enter your credentials to access the system
 </MudText>

        @if (!string.IsNullOrEmpty(errorMessage))
   {
     <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
 <p class="text-sm text-red-600">@errorMessage</p>
 </div>
}

     <!-- Formulario de Login -->
      <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin" FormName="LoginForm">
    <DataAnnotationsValidator />

<div class="space-y-4">
      <!-- Email -->
 <div>
 <label class="block text-sm font-medium mb-2 dark:text-white">Email</label>
 <InputText @bind-Value="loginModel.Email" 
  placeholder="Enter your email" 
 class="form-input w-full px-4 py-3 border border-black/10 dark:border-darkborder rounded-lg focus:ring-2 focus:ring-purple focus:border-transparent dark:bg-dark dark:text-white" />
  <ValidationMessage For="@(() => loginModel.Email)" class="text-red-500 text-sm mt-1" />
       </div>

    <!-- Password -->
   <div>
<label class="block text-sm font-medium mb-2 dark:text-white">Password</label>
  <InputText @bind-Value="loginModel.Password" 
   type="password"
      placeholder="Enter your password" 
   class="form-input w-full px-4 py-3 border border-black/10 dark:border-darkborder rounded-lg focus:ring-2 focus:ring-purple focus:border-transparent dark:bg-dark dark:text-white" />
        <ValidationMessage For="@(() => loginModel.Password)" class="text-red-500 text-sm mt-1" />
     </div>

     <div class="ltr:text-right rtl:text-left">
    <MudLink Href="/forgot-password" Class="text-black dark:text-white">Forgot Password?</MudLink>
</div>

<!-- Submit Button -->
<button type="submit" 
   disabled="@isLoading"
 class="btn w-full py-3.5 text-base bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85] disabled:opacity-50">
  @if (isLoading)
  {
   <span>Signing in...</span>
  }
      else
 {
     <span>Sign In</span>
        }
   </button>
      </div>
  </EditForm>

        <!-- Demo Credentials -->
        <div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
    <p class="text-sm font-semibold text-blue-900 dark:text-blue-200 mb-2">Demo Credentials:</p>
  <div class="space-y-1 text-sm text-blue-700 dark:text-blue-300">
    <p><strong>Admin:</strong> admin@vrm.com / admin123</p>
   <p><strong>User:</strong> user@vrm.com / user123</p>
        <p><strong>Contador:</strong> contador@vrm.com / contador123</p>
</div>
 </div>

<MudText Class="mt-5 text-center text-muted dark:text-darkmuted">
  Not a Member yet? <MudLink Href="/signup" Class="text-black dark:text-white">Create an Account</MudLink>
     </MudText>
  </div>
</div>

@code {
  [SupplyParameterFromQuery]
public string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    private LoginModel loginModel { get; set; } = new();
    
    private string? errorMessage;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
   errorMessage = null;

        try
        {
            Console.WriteLine("🔵 Iniciando login...");
  
  // Intentar login con DummyAuthenticationStateProvider
            var success = await AuthProvider.LoginAsync(loginModel.Email ?? "", loginModel.Password ?? "");

            Console.WriteLine($"🔵 Login resultado: {success}");

            if (success)
        {
                // ✅ Determinar URL de redirección
                var redirectUrl = string.IsNullOrEmpty(ReturnUrl) ? "/index" : ReturnUrl;
    
    Console.WriteLine($"🔵 Navegando a: {redirectUrl}");
   
              // ✅ CRÍTICO: forceLoad=true es NECESARIO aquí porque:
            // 1. Login.razor es SSR estático (sin @rendermode)
    // 2. Index.razor requiere @rendermode InteractiveServer
        // 3. Debe crear un nuevo Blazor Server Circuit para leer las cookies
         // 4. NavigationException es el comportamiento esperado de Blazor
         // 
                // ⚠️ NO capturar NavigationException - es intencional
                Navigation.NavigateTo(redirectUrl, forceLoad: true);
 }
        else
     {
         Console.WriteLine("🔴 Login falló - credenciales inválidas");
    errorMessage = "Invalid email or password. Please try again.";
      isLoading = false;
            }
     }
        catch (Exception ex) when (ex is not NavigationException)
        {
            // Solo capturar excepciones reales, NO NavigationException
     Console.WriteLine($"🔴 Error: {ex.Message}");
            errorMessage = $"An error occurred: {ex.Message}";
            isLoading = false;
}
    }

    public class LoginModel
    {
 [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email format")]
   public string? Email { get; set; }

[Required(ErrorMessage = "Password is required")]
[MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string? Password { get; set; }
    }
}
