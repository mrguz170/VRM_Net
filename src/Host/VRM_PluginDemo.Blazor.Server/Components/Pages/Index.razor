@page "/index"
<!-- ? SOLO /index, como Sliced -->
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using VRM_Plugin.Blazor.Server.Services
@inject AuthenticationStateProvider AuthProvider
@inject IModuleManager ModuleManager
@inject IModuleAuthorizationService AuthService
@inject IRoleDisplayNameService RoleService

<PageTitle>Dashboard - VRM Plugin Demo</PageTitle>

<!-- Dashboard Page -->
<div class="flex flex-col gap-4 min-h-[calc(100vh-212px)]">
    
    <!-- Welcome Section -->
    <div class="bg-white dark:bg-darklight p-6 rounded-lg shadow-sm border border-black/10 dark:border-darkborder">
        <AuthorizeView>
            <Authorized>
                <h1 class="text-3xl font-bold text-gray-800 dark:text-white mb-2">
                    Welcome back, @context.User.Identity?.Name!
                </h1>
                <p class="text-gray-600 dark:text-gray-400">
                    You are logged in as <strong>@(GetUserRole(context))</strong>
                </p>
            </Authorized>
        </AuthorizeView>
    </div>

    <!-- System Overview Cards -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    
        <!-- Total Modules Card -->
        <div class="flex items-center justify-between gap-6 p-5 border rounded dark:border-darkborder border-black/10 bg-white dark:bg-darklight">
            <div>
                <MudText Class="text-base dark:text-gray-300">Total Modules</MudText>
                <MudText Typo="Typo.h4" Class="mt-3 text-2xl font-semibold text-slate-800 dark:text-slate-100">
                    @ModuleManager.GetAllModules().Count()
                </MudText>
                <MudText Class="text-muted">Plugin System</MudText>
            </div>
            <div class="text-purple text-4xl">
                <i class="ri-plug-line"></i>
            </div>
        </div>

        <!-- Total Components Card -->
        <div class="flex items-center justify-between gap-6 p-5 border rounded dark:border-darkborder border-black/10 bg-white dark:bg-darklight">
            <div>
                <MudText Class="text-base dark:text-white/80">Total Components</MudText>
                <MudText Typo="Typo.h4" Class="mt-3 text-2xl font-semibold text-slate-800 dark:text-slate-100">
                    @ModuleManager.GetAllModules().SelectMany(m => m.GetComponents()).Count()
                </MudText>
                <MudText Class="text-muted">Available Features</MudText>
            </div>
            <div class="text-info text-4xl">
                <i class="ri-function-line"></i>
            </div>
        </div>

        <!-- Accessible Components Card -->
        <div class="flex items-center justify-between gap-6 p-5 border rounded dark:border-darkborder border-black/10 bg-white dark:bg-darklight">
            <div>
                <MudText Class="text-base dark:text-white/80">Your Access</MudText>
                <MudText Typo="Typo.h4" Class="mt-3 text-2xl font-semibold text-slate-800 dark:text-slate-100">
                    @(_visibleComponents?.Count ?? 0)
                </MudText>
                <MudText Class="text-muted">Components Available</MudText>
            </div>
            <div class="text-success text-4xl">
                <i class="ri-checkbox-circle-line"></i>
            </div>
        </div>

        <!-- Architecture Card -->
        <div class="flex items-center justify-between gap-6 p-5 border rounded dark:border-darkborder border-black/10 bg-white dark:bg-darklight">
            <div>
                <MudText Class="text-base dark:text-white/80">Architecture</MudText>
                <MudText Typo="Typo.h4" Class="mt-3 text-2xl font-semibold text-slate-800 dark:text-slate-100">
                    Plugin
                </MudText>
                <MudText Class="text-muted">Pattern Active</MudText>
            </div>
            <div class="text-warning text-4xl">
                <i class="ri-settings-3-line"></i>
            </div>
        </div>
    </div>

    <!-- Available Modules Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        @if (_isLoading)
        {
            <div class="col-span-full text-center py-8">
                <p class="text-gray-500 dark:text-gray-400">Loading your accessible components...</p>
            </div>
        }
        else if (_visibleComponents != null && _visibleComponents.Any())
        {
            @* Solo mostrar componentes que tienen ruta (no categorías) *@
            @foreach (var component in _visibleComponents.Where(c => !string.IsNullOrEmpty(c.Route)))
            {
                <div class="bg-white dark:bg-darklight p-6 rounded-lg shadow-sm border border-black/10 dark:border-darkborder hover:shadow-md transition-shadow">
                    <div class="flex items-center mb-4">
                        @* ? Usar icono del componente *@
                        <i class="@component.Icon text-purple text-3xl mr-4"></i>
                        <div>
                            <h3 class="text-xl font-semibold text-gray-800 dark:text-white">
                                @component.Name
                            </h3>
                            <p class="text-sm text-gray-500 dark:text-gray-400">
                                @component.Route
                            </p>
                        </div>
                    </div>
                    
                    <p class="text-gray-600 dark:text-gray-400 mb-4">
                        @if (!string.IsNullOrEmpty(component.Description))
                        {
                            @component.Description
                        }
                        else
                        {
                            <text>Component available in the plugin system</text>
                        }
                    </p>

                    <a href="@component.Route" 
                       class="inline-block px-4 py-2 bg-purple text-white rounded hover:bg-purple/90 transition-colors">
                        Open Module
                    </a>
                    
                    @* Badge para indicar si hereda permisos *@
                    @if (component.IdParent.HasValue)
                    {
                        <span class="ml-2 text-xs px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 rounded">
                            <i class="ri-parent-line"></i> Inherits Permissions
                        </span>
                    }
                </div>
            }
        }
        else
        {
            <div class="col-span-full">
                <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 p-6 rounded-lg">
                    <div class="flex items-center gap-3 mb-3">
                        <i class="ri-information-line text-yellow-600 dark:text-yellow-400 text-2xl"></i>
                        <h3 class="text-lg font-semibold text-yellow-800 dark:text-yellow-200">
                            No Accessible Modules
                        </h3>
                    </div>
                    <p class="text-yellow-800 dark:text-yellow-200">
                        You don't have access to any modules yet. Please contact your administrator to get the necessary permissions.
                    </p>
                </div>
            </div>
        }
    </div>

    <!-- System Information -->
    <div class="bg-white dark:bg-darklight p-6 rounded-lg shadow-sm border border-black/10 dark:border-darkborder">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-4">System Information</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            
            <div class="p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
                <p class="text-sm text-blue-600 dark:text-blue-400 font-semibold mb-2">Framework</p>
                <p class="text-lg font-bold text-blue-900 dark:text-blue-200">.NET 8</p>
                <p class="text-xs text-blue-700 dark:text-blue-300">Blazor Web App</p>
            </div>

            <div class="p-4 bg-green-50 dark:bg-green-900/20 rounded-lg border border-green-200 dark:border-green-800">
                <p class="text-sm text-green-600 dark:text-green-400 font-semibold mb-2">Render Mode</p>
                <p class="text-lg font-bold text-green-900 dark:text-green-200">Interactive Server</p>
                <p class="text-xs text-green-700 dark:text-green-300">SignalR Active</p>
            </div>

            <div class="p-4 bg-purple-50 dark:bg-purple-900/20 rounded-lg border border-purple-200 dark:border-purple-800">
                <p class="text-sm text-purple-600 dark:text-purple-400 font-semibold mb-2">UI Framework</p>
                <p class="text-lg font-bold text-purple-900 dark:text-purple-200">Sliced + MudBlazor</p>
                <p class="text-xs text-purple-700 dark:text-purple-300">Tailwind CSS</p>
            </div>
        </div>
    </div>
</div>

@code {
    private List<VRM_Plugin.Core.Abstractions.Entities.ModuleComponent>? _visibleComponents;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            
            // ? Obtener componentes visibles basados en permisos del usuario
            _visibleComponents = await AuthService.GetVisibleComponentsAsync();
            
            _isLoading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading visible components: {ex.Message}");
            _visibleComponents = new List<VRM_Plugin.Core.Abstractions.Entities.ModuleComponent>();
            _isLoading = false;
        }
    }

    /// <summary>
    /// ? Obtiene el nombre de visualización del rol del usuario.
    /// Usa IRoleDisplayNameService para mapear IDs de roles a nombres amigables.
    /// Sin roles hardcodeados en el componente.
    /// </summary>
    private string GetUserRole(AuthenticationState state)
    {
        // Obtener el primer rol del usuario
        var roleId = state.User.Claims
            .FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
        
        // Si no tiene rol, mostrar "Guest"
        if (string.IsNullOrWhiteSpace(roleId))
            return "Guest";
        
        // ? Usar servicio para obtener nombre de visualización
        return RoleService.GetDisplayName(roleId);
    }
}
