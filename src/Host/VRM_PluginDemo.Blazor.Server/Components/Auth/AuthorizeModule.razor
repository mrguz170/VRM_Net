@using Microsoft.AspNetCore.Components.Authorization
@using VRM_Plugin.Blazor.Server.Services
@inject IModuleAuthorizationService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<AuthorizeModule> Logger

@* Renderizar contenido solo si el usuario tiene acceso al componente *@
@if (_isAuthorized)
{
    @ChildContent
}
else if (_isLoading)
{
    <p><em>Verificando permisos...</em></p>
}
else
{
    <div class="alert alert-warning" role="alert">
        <h4 class="alert-heading">?? Acceso Denegado</h4>
        <p>No tienes permisos para acceder a este componente.</p>
        @if (!string.IsNullOrEmpty(_deniedReason))
        {
            <hr>
            <p class="mb-0 text-muted"><small>@_deniedReason</small></p>
        }
        <hr>
        <p class="mb-0">Contacta al administrador si crees que esto es un error.</p>
    </div>
}

@code {
    /// <summary>
    /// ? NUEVO: ID numérico del componente a verificar.
    /// Ejemplo: 2 (Facturas), 3 (Cobros y Pagos), 4 (Prospectos)
    /// </summary>
    [Parameter]
    public int? IdComponent { get; set; }

    /// <summary>
    /// ?? LEGACY: ID del módulo como string (obsoleto, se mantiene para compatibilidad).
    /// Se recomienda usar IdComponent o IdModule en su lugar.
    /// </summary>
    [Parameter]
    public string? ModuleId { get; set; }

    /// <summary>
    /// ? NUEVO: ID numérico del módulo a verificar.
    /// Ejemplo: 1 (Finanzas), 2 (Prospectos)
    /// </summary>
    [Parameter]
    public int? IdModule { get; set; }

    /// <summary>
    /// Contenido a renderizar si el usuario tiene acceso
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _isAuthorized = false;
    private bool _isLoading = true;
    private string? _deniedReason;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            // Verificar que al menos un parámetro de identificación esté presente
            if (!IdComponent.HasValue && !IdModule.HasValue && string.IsNullOrEmpty(ModuleId))
            {
                _deniedReason = "Configuración inválida del componente de autorización";
                _isAuthorized = false;
                _isLoading = false;
                return;
            }

            // Obtener estado de autenticación
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // Verificar si está autenticado
            if (!user.Identity?.IsAuthenticated ?? true)
            {
                _deniedReason = "Debes iniciar sesión para acceder a este recurso";
                _isAuthorized = false;
                _isLoading = false;
                return;
            }

            // Verificar acceso según el parámetro proporcionado
            if (IdComponent.HasValue)
            {
                // ? OPCIÓN 1: Verificar por IdComponent (más específico, recomendado)
                _isAuthorized = await AuthService.CanAccessComponentAsync(IdComponent.Value);
                
                if (!_isAuthorized)
                {
                    _deniedReason = $"No tienes permisos para acceder al componente ID: {IdComponent.Value}";
                }
            }
            else if (IdModule.HasValue)
            {
                // ? OPCIÓN 2: Verificar por IdModule (verifica acceso a cualquier componente del módulo)
                var visibleComponents = await AuthService.GetVisibleComponentsAsync();
                _isAuthorized = visibleComponents.Any(c => c.IdModule == IdModule.Value);

                if (!_isAuthorized)
                {
                    _deniedReason = $"No tienes permisos para acceder al módulo ID: {IdModule.Value}";
                }

            }
            else if (!string.IsNullOrEmpty(ModuleId))
            {
                // ?? OPCIÓN 3: LEGACY - Verificar por ModuleId (string, obsoleto)
                Logger.LogWarning(
                    "Uso de ModuleId (string) está obsoleto. Usa IdModule (int) o IdComponent (int) en su lugar.");

                var visibleComponents = await AuthService.GetVisibleComponentsAsync();
                
                // Intentar parsear como int primero
                if (int.TryParse(ModuleId, out var moduleIdInt))
                {
                    _isAuthorized = visibleComponents.Any(c => c.IdModule == moduleIdInt);
                }
                else
                {
                    // Fallback: buscar por ModuleName (lento, no recomendado)
                    _isAuthorized = false;
                    _deniedReason = "ModuleId debe ser un ID numérico válido";
                }
            }

            _isLoading = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al verificar permisos");
            _deniedReason = "Error al verificar permisos. Intenta nuevamente.";
            _isAuthorized = false;
            _isLoading = false;
        }
    }
}
