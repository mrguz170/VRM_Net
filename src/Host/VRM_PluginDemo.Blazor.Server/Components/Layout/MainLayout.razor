@inherits LayoutComponentBase
@inject IJSRuntime JsRuntime

<!-- MudBlazor Providers -->
<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<!-- Sliced Layout Structure -->
<div class="bg-[#f9fbfd] dark:bg-dark">

    <!-- Background image for detached layout -->
  <div class="bg-black min-h-[220px] sm:min-h-[250px] bg-bottom fixed hidden w-full -z-50 detached-img" style="background-image: url('assets/images/bg-main.png');"></div>

    <!-- Mobile sidebar overlay -->
    <div x-cloak class="fixed inset-0 bg-black/60 dark:bg-dark/90 z-[999] lg:hidden" :class="{'hidden' : !$store.app.sidebar}" @click="$store.app.toggleSidebar()"></div>

    <!-- Main container -->
    <div class="flex mx-auto main-container">
     
   <!-- Sidebar Component -->
        <Sidebar />

        <!-- Main content area -->
        <div class="flex-1 main-content">

     <!-- Topbar Component -->
       <Topbar />
    
         <!-- Content area with dynamic module rendering -->
     <div class="h-[calc(100vh-60px)] relative overflow-y-auto overflow-x-hidden p-4 space-y-4 detached-content">

   <!-- Dynamic module content rendered here -->
       @Body

       <!-- Footer Component -->
 <Footer />

      </div>
  </div>
    </div>
</div>

<!-- RTL/LTR Toggle Button -->
<button type="button" class="fixed z-50 px-4 text-white border-gray-200 shadow-lg h-11 ltr:right-0 rtl:left-0 bg-purple ltr:rounded-l-md rtl:rounded-r-md top-1/3" @click="$store.app.direction === 'ltr' ? $store.app.direction = 'rtl' : $store.app.direction = 'ltr'">
    <span x-text="$store.app.direction === 'ltr' ? 'RTL' : 'LTR'"></span>
</button>

<!-- Blazor Error UI -->
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">??</a>
</div>
