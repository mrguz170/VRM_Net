@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using VRM_Plugin.Core.Abstractions.Entities
@using VRM_Plugin.Blazor.Server.Services
@using Microsoft.Extensions.Logging
@inject IModuleManager ModuleManager
@inject IModuleAuthorizationService AuthService
@inject ILogger<Sidebar> Logger
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthStateProvider

<!-- Sidebar -->
<nav class="sidebar lg:z-[9] z-[10]">
    <div class="h-full bg-white dark:bg-darklight group-data-[sidebar=dark]/item:bg-darklight group-data-[sidebar=brand]/item:bg-sky-950">
  
        <!-- Logo -->
        <div class="p-4">
            <a href="/" class="w-full main-logo">
                <img src="assets/images/logo-dark.svg" class="mx-auto dark-logo h-7 logo dark:hidden group-data-[sidebar=dark]/item:hidden group-data-[sidebar=brand]/item:hidden" alt="VRM Logo" />
                <img src="assets/images/logo-light.svg" class="hidden mx-auto light-logo h-7 logo dark:block group-data-[sidebar=dark]/item:block group-data-[sidebar=brand]/item:block" alt="VRM Logo" />
                <img src="assets/images/logo-icon.svg" class="hidden mx-auto logo-icon h-7" alt="VRM Icon">
            </a>
        </div>
    
        <!-- Menu -->
        <div class="h-[calc(100vh-60px)] overflow-y-auto overflow-x-hidden px-5 pb-4 space-y-16 detached-menu">
      
            <!-- Dynamic Modules Menu - JavaScript vanilla -->
            <ul class="relative flex flex-col gap-1" id="sidebar-menu">
  
                <!-- Section: Menu -->
                <MudText Typo="Typo.h2" Class="my-2 text-sm text-black/50 dark:text-white/30 group-data-[sidebar=dark]/item:text-white/30 group-data-[sidebar=brand]/item:text-sky-200/50">
                    <span>Menu</span>
                </MudText>

                <!-- Home -->
                <li class="menu nav-item">
                    <NavLink href="/" class="nav-link group" Match="NavLinkMatch.All">
                        <div class="flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5">
                                <path d="M19 21H5C4.44772 21 4 20.5523 4 20V11L1 11L11.3273 1.6115C11.7087 1.26475 12.2913 1.26475 12.6727 1.6115L23 11L20 11V20C20 20.5523 19.5523 21 19 21ZM6 19H18V9.15745L12 3.7029L6 9.15745V19Z" fill="currentColor"></path>
                            </svg>
                            <span class="ltr:pl-1.5 rtl:pr-1.5">Home</span>
                        </div>
                    </NavLink>
                </li>
 
                <!-- Only show modules when authenticated -->
                <AuthorizeView>
                    <Authorized>
                        <!-- Section: Modulos -->
                        <MudText Typo="Typo.h2" Class="my-2 text-sm text-black/50 dark:text-white/30 group-data-[sidebar=dark]/item:text-white/30 group-data-[sidebar=brand]/item:text-sky-200/50">
                            <span>Módulos</span>
                        </MudText>

                        @if (_visibleComponents != null && _visibleComponents.Any())
                        {
                            @foreach (var rootComponent in _visibleComponents.Where(c => c.IdParent == null))
                            {
                                var children = _visibleComponents.Where(c => c.IdParent == rootComponent.IdComponent && !string.IsNullOrEmpty(c.Route)).ToList();
                                var menuId = $"module_{rootComponent.IdComponent}";
                                
                                @if (children.Any())
                                {
                                    <li class="menu nav-item">
                                        <a href="javascript:void(0);" 
                                           class="items-center justify-between text-black nav-link group"
                                           data-menu-id="@menuId"
                                           onclick="toggleSidebarDropdown('@menuId')">
                                            <div class="flex items-center">
                                                <i class="@rootComponent.Icon w-5 text-2xl"></i>
                                                <span class="ltr:pl-1.5 rtl:pr-1.5">@rootComponent.Name</span>
                                            </div>
                                            <div class="flex items-center justify-center w-4 h-4 dropdown-icon transition-transform duration-300">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-6 h-6">
                                                    <path d="M11.9997 13.1714L16.9495 8.22168L18.3637 9.63589L11.9997 15.9999L5.63574 9.63589L7.04996 8.22168L11.9997 13.1714Z" fill="currentColor"></path>
                                                </svg>
                                            </div>
                                        </a>
                                        
                                        <ul id="@menuId" 
                                            class="flex-col gap-1 text-black sub-menu dark:text-white/60 overflow-hidden transition-all duration-300 ease-in-out"
                                            style="max-height: 0; opacity: 0; display: none;">
                                            @foreach (var child in children)
                                            {
                                                <li>
                                                    <NavLink href="@child.Route">
                                                        <div class="flex items-center">
                                                            @* ✅ Mostrar icono SOLO si ShowAllIcons = true *@
                                                            @if (_showAllIcons && !string.IsNullOrEmpty(child.Icon))
                                                            {
                                                                <i class="@child.Icon w-5 text-lg mr-2"></i>
                                                            }
                                                            <span>@child.Name</span>
                                                        </div>
                                                    </NavLink>
                                                </li>
                                            }
                                        </ul>
                                    </li>
                                }
                                else if (!string.IsNullOrEmpty(rootComponent.Route))
                                {
                                    <li class="menu nav-item">
                                        <NavLink href="@rootComponent.Route" class="nav-link group">
                                            <div class="flex items-center">
                                                <i class="@rootComponent.Icon w-5 text-2xl"></i>
                                                <span class="ltr:pl-1.5 rtl:pr-1.5">@rootComponent.Name</span>
                                            </div>
                                        </NavLink>
                                    </li>
                                }
                            }
                        }
                        else if (_isLoading)
                        {
                            <li class="menu nav-item">
                                <div class="nav-link group">
                                    <div class="flex items-center">
                                        <span class="ltr:pl-1.5 rtl:pr-1.5">Cargando módulos...</span>
                                    </div>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="menu nav-item">
                                <div class="nav-link group">
                                    <div class="flex items-center text-gray-500">
                                        <span class="ltr:pl-1.5 rtl:pr-1.5">No hay módulos disponibles</span>
                                    </div>
                                </div>
                            </li>
                        }

                        <!-- Section: Sistema -->
                        <MudText Typo="Typo.h2" Class="my-2 text-sm text-black/50 dark:text-white/30 group-data-[sidebar=dark]/item:text-white/30 group-data-[sidebar=brand]/item:text-sky-200/50">
                            <span>Sistema</span>
                        </MudText>
          
                        <li class="menu nav-item">
                            <NavLink href="/modules-info" class="nav-link group">
                                <div class="flex items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5">
                                        <path d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM12 20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4C7.58172 4 4 7.58172 4 12C4 16.4183 7.58172 20 12 20ZM11 7H13V9H11V7ZM11 11H13V17H11V11Z" fill="currentColor"></path>
                                    </svg>
                                    <span class="ltr:pl-1.5 rtl:pr-1.5">Modules Info</span>
                                </div>
                            </NavLink>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <MudText Typo="Typo.h2" Class="my-2 text-sm text-black/50 dark:text-white/30 group-data-[sidebar=dark]/item:text-white/30 group-data-[sidebar=brand]/item:text-sky-200/50">
                            <span>Please login to view modules</span>
                        </MudText>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>

<script>
    // ✅ Función para toggle de dropdown individual
    window.toggleSidebarDropdown = function(menuId) {
        const submenu = document.getElementById(menuId);
        const link = document.querySelector('[data-menu-id="' + menuId + '"]');
        const icon = link?.querySelector('.dropdown-icon');
        
        if (!submenu || !link) {
            console.error('[toggleSidebarDropdown] Elemento no encontrado:', menuId);
            return;
        }
        
        const isOpen = submenu.style.display === 'flex';
        
        // Cerrar otros menús
        document.querySelectorAll('[id^="module_"]').forEach(function(menu) {
            if (menu.id !== menuId && menu.style.display === 'flex') {
                menu.style.maxHeight = '0';
                menu.style.opacity = '0';
                setTimeout(function() { menu.style.display = 'none'; }, 300);
                
                const otherLink = document.querySelector('[data-menu-id="' + menu.id + '"]');
                const otherIcon = otherLink?.querySelector('.dropdown-icon');
                if (otherIcon) otherIcon.classList.remove('rotate-180');
                if (otherLink) otherLink.classList.remove('active');
            }
        });
        
        if (isOpen) {
            // Cerrar este menú
            submenu.style.maxHeight = '0';
            submenu.style.opacity = '0';
            setTimeout(function() { submenu.style.display = 'none'; }, 300);
            icon.classList.remove('rotate-180');
            link.classList.remove('active');
        } else {
            // Abrir este menú
            submenu.style.display = 'flex';
            const realHeight = submenu.scrollHeight;
            setTimeout(function() { 
                submenu.style.maxHeight = realHeight + 'px';
                submenu.style.opacity = '1';
            }, 10);
            icon.classList.add('rotate-180');
            link.classList.add('active');
        }
    };
    
    // ✅ SOLUCIÓN: Cerrar todos los dropdowns cuando el sidebar se colapsa
    window.closeAllSidebarDropdowns = function() {
        document.querySelectorAll('[id^="module_"]').forEach(function(menu) {
            if (menu.style.display === 'flex') {
                // Cerrar inmediatamente sin animación (para evitar texto visible)
                menu.style.maxHeight = '0';
                menu.style.opacity = '0';
                menu.style.display = 'none';
                
                // Resetear iconos y estados
                const link = document.querySelector('[data-menu-id="' + menu.id + '"]');
                const icon = link?.querySelector('.dropdown-icon');
                if (icon) icon.classList.remove('rotate-180');
                if (link) link.classList.remove('active');
            }
        });
    };
    
    // ✅ Observar cambios en la clase 'toggle-sidebar' del body
    (function() {
        const body = document.querySelector('body');
        
        if (!body) {
            console.error('[Sidebar] Body no encontrado');
            return;
        }
        
        // Usar MutationObserver para detectar cambios de clase
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                    const hasToggleSidebar = body.classList.contains('toggle-sidebar');
                    
                    if (hasToggleSidebar) {
                        // Sidebar colapsado → cerrar todos los dropdowns
                        window.closeAllSidebarDropdowns();
                    }
                }
            });
        });
        
        // Iniciar observación
        observer.observe(body, {
            attributes: true,
            attributeFilter: ['class']
        });
    })();
</script>

@code {
    private List<ModuleComponent>? _visibleComponents;
    private bool _isLoading = true;
    private string? _currentUser;

    // ✅ Bandera de configuración para visibilidad de iconos
    // TODO: Obtener de base de datos (tabla Configuracion o Cliente)
    private bool _showAllIcons = false; // Por defecto: mostrar todos los iconos

    protected override async Task OnInitializedAsync()
    {
        var startTime = DateTime.UtcNow;
        
        try
        {
            _isLoading = true;

            // Obtener usuario actual para logging
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _currentUser = user.Identity?.Name ?? "Anonymous";

            Logger.LogInformation(
                "[Sidebar] Iniciando carga de componentes visibles para usuario: {User}",
                _currentUser);

            // ✅ Obtener componentes visibles
            _visibleComponents = await AuthService.GetVisibleComponentsAsync();

            var componentsCount = _visibleComponents?.Count ?? 0;
            var rootCount = _visibleComponents?.Count(c => c.IdParent == null) ?? 0;
            var childCount = _visibleComponents?.Count(c => c.IdParent != null) ?? 0;

            Logger.LogInformation(
                "[Sidebar] Componentes cargados para usuario {User}: Total={TotalCount}, Raíz={RootCount}, Hijos={ChildCount}, Tiempo={ElapsedMs}ms",
                _currentUser,
                componentsCount,
                rootCount,
                childCount,
                (DateTime.UtcNow - startTime).TotalMilliseconds);

            // ✅ TODO: Obtener configuración de visibilidad de iconos desde BD
            // _showAllIcons = await ConfigService.GetShowAllIconsAsync();
            _showAllIcons = false;

            if (!_visibleComponents?.Any() ?? true)
            {
                Logger.LogWarning(
                    "[Sidebar] No se encontraron componentes visibles para usuario {User}. " +
                    "Verificar permisos o configuración de módulos.",
                    _currentUser);
            }

            _isLoading = false;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex,
                "[Sidebar] Usuario {User} no tiene permisos para acceder a componentes",
                _currentUser ?? "Unknown");
            
            _visibleComponents = new List<ModuleComponent>();
            _isLoading = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "[Sidebar] Error crítico al cargar componentes visibles para usuario {User}. " +
                "Tiempo transcurrido: {ElapsedMs}ms",
                _currentUser ?? "Unknown",
                (DateTime.UtcNow - startTime).TotalMilliseconds);
            
            _visibleComponents = new List<ModuleComponent>();
            _isLoading = false;
            
            // Re-throw si es un error crítico del sistema
            if (ex is OutOfMemoryException || ex is StackOverflowException)
            {
                throw;
            }
        }
    }
}
