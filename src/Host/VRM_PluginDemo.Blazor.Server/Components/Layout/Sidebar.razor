@inject IModuleManager ModuleManager
@inject IJSRuntime JsRuntime

<!-- Sidebar -->
<nav class="sidebar lg:z-[9] z-[10]">
    <div class="h-full bg-white dark:bg-darklight group-data-[sidebar=dark]/item:bg-darklight group-data-[sidebar=brand]/item:bg-sky-950">
        
        <!-- Logo -->
        <div class="p-4">
   <a href="/" class="w-full main-logo">
 <img src="assets/images/logo-dark.svg" class="mx-auto dark-logo h-7 logo dark:hidden group-data-[sidebar=dark]/item:hidden group-data-[sidebar=brand]/item:hidden" alt="VRM Logo" />
     <img src="assets/images/logo-light.svg" class="hidden mx-auto light-logo h-7 logo dark:block group-data-[sidebar=dark]/item:block group-data-[sidebar=brand]/item:block" alt="VRM Logo" />
         <img src="assets/images/logo-icon.svg" class="hidden mx-auto logo-icon h-7" alt="VRM Icon">
  </a>
        </div>
    
        <!-- Menu -->
  <div class="h-[calc(100vh-60px)] overflow-y-auto overflow-x-hidden px-5 pb-4 space-y-4 detached-menu">
      
            <!-- Dynamic Modules Menu -->
       <ul class="relative flex flex-col gap-1">
       
     <!-- Home -->
                <li class="menu nav-item">
     <NavLink href="/" class="nav-link group" Match="NavLinkMatch.All">
       <div class="flex items-center">
   <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5">
          <path d="M19 21H5C4.44772 21 4 20.5523 4 20V11L1 11L11.3273 1.6115C11.7087 1.26475 12.2913 1.26475 12.6727 1.6115L23 11L20 11V20C20 20.5523 19.5523 21 19 21ZM6 19H18V9.15745L12 3.7029L6 9.15745V19Z" fill="currentColor"></path>
        </svg>
              <span class="ltr:pl-1.5 rtl:pr-1.5">Home</span>
              </div>
           </NavLink>
          </li>
 
       <!-- Only show modules when authenticated -->
     <AuthorizeView>
         <Authorized>
     <!-- Section header for modules -->

        @* <h2 Class="my-2  !font-normal text-black/50 dark:text-white/30 group-data-[sidebar=dark]/item:text-white/30 group-data-[sidebar=brand]/item:text-sky-200/50">
            <span>Modulos</span>
        </h2> *@

        <h2 class="my-2 text-base font-bold text-black/50 dark:text-white/30 group-data-[sidebar=dark]/item:text-white/30 group-data-[sidebar=brand]/item:text-sky-200/50">
            <span>Modulos</span>
        </h2>


    
       <!-- Dynamic module menu items -->
       @foreach (var module in ModuleManager.GetAllModules())
              {
           var components = module.GetComponents().Where(c => c.ShowInMenu).OrderBy(c => c.MenuOrder);
         
     @foreach (var component in components)
                {
            <li class="menu nav-item">
            <NavLink href="@component.Route" class="nav-link group">
     <div class="flex items-center">
 @if (!string.IsNullOrEmpty(component.Icon))
            {
      <i class="@component.Icon w-5 h-5"></i>
                 }
         else
         {
   <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5">
 <path d="M12 1L21.5 6.5V17.5L12 23L2.5 17.5V6.5L12 1ZM12 3.311L5.5 7.65329V16.3469L12 20.6891L18.5 16.3469V7.65329L12 3.311Z" fill="currentColor"></path>
             </svg>
       }
 <span class="ltr:pl-1.5 rtl:pr-1.5">@component.Name</span>
   </div>
          </NavLink>
    </li>
      }
     }

         <!-- Module Info (for debugging/admin) -->
        @* <h2 Class="my-2 text-black/50 dark:text-white/30 group-data-[sidebar=dark]/item:text-white/30 group-data-[sidebar=brand]/item:text-sky-200/50">
            <span>Sistema</span>
        </h2> *@

        <h2 class="my-2 text-base font-bold text-black/50 dark:text-white/30 group-data-[sidebar=dark]/item:text-white/30 group-data-[sidebar=brand]/item:text-sky-200/50">
            <span>Sistema</span>
        </h2>
          
      <li class="menu nav-item">
       <NavLink href="/modules-info" class="nav-link group">
     <div class="flex items-center">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5">
         <path d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM12 20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4C7.58172 4 4 7.58172 4 12C4 16.4183 7.58172 20 12 20ZM11 7H13V9H11V7ZM11 11H13V17H11V11Z" fill="currentColor"></path>
    </svg>
        <span class="ltr:pl-1.5 rtl:pr-1.5">Modules Info</span>
   </div>
     </NavLink>
      </li>
       </Authorized>
       <NotAuthorized>
     @* <h2 Class="my-2 text-black/50 dark:text-white/30 group-data-[sidebar=dark]/item:text-white/30 group-data-[sidebar=brand]/item:text-sky-200/50">
<span>Please login to view modules</span>
     </h2> *@

        <h2 class="my-2 text-base font-bold text-black/50 dark:text-white/30 group-data-[sidebar=dark]/item:text-white/30 group-data-[sidebar=brand]/item:text-sky-200/50">
            <span>Please login to view modules</span>
        </h2>

     </NotAuthorized>
    </AuthorizeView>
        </ul>
   </div>
    </div>
</nav>

@code {
 // Component logic here if needed
}
