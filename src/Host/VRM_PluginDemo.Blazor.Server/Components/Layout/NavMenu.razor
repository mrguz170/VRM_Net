@using VRM_Plugin.Blazor.Server.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IModuleManager ModuleManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">VRM Plugin Demo</a>
        
     @if (_isAuthenticated && !string.IsNullOrEmpty(_userName))
        {
         <span class="navbar-text text-white me-3">
    <span class="bi bi-person-circle"></span> @_userName
            </span>
        }
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <!-- Enlaces estáticos -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
         <span class="bi bi-house-door-fill" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

     @if (_isAuthenticated)
        {
            <!-- Solo Admin puede ver módulos cargados -->
   @if (_userRoles?.Contains("Admin") ?? false)
   {
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="modules">
       <span class="bi bi-plug-fill" aria-hidden="true"></span> Módulos Cargados
         </NavLink>
     </div>
            }

   <!-- Separador -->
            <hr class="my-2" />

        <!-- ✅ Enlaces dinámicos de módulos FILTRADOS por permisos -->
    @if (_userRoles != null && _userRoles.Any())
  {
              @foreach (var module in ModuleManager.GetAllModules())
     {
         @* Verificar si el usuario tiene al menos uno de los roles requeridos *@
        var userCanAccessModule = module.RequiredPermissions.Any(p => _userRoles.Contains(p));
        
         @if (userCanAccessModule)
      {
       @foreach (var component in module.GetComponents().Where(c => c.ShowInMenu).OrderBy(c => c.MenuOrder))
   {
 <div class="nav-item px-3">
    <NavLink class="nav-link" href="@component.Route">
              <span class="@component.Icon" aria-hidden="true"></span> @component.Name
       </NavLink>
                 </div>
          }
           }
         }
  }

            <hr class="my-2" />

          <!-- Logout -->
            <div class="nav-item px-3">
    <NavLink class="nav-link" href="logout">
            <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Cerrar Sesión
         </NavLink>
            </div>
}
        else
        {
        <div class="nav-item px-3">
 <NavLink class="nav-link" href="login">
         <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Iniciar Sesión
    </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private List<string>? _userRoles;
    private bool _isAuthenticated;
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        // Obtener roles del usuario autenticado
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _isAuthenticated = user.Identity?.IsAuthenticated ?? false;
        _userName = user.Identity?.Name;

        if (_isAuthenticated)
 {
     _userRoles = user.Claims
      .Where(c => c.Type == ClaimTypes.Role)
      .Select(c => c.Value)
      .ToList();
        }
    }
}