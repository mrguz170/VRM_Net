@inherits LayoutComponentBase

<!-- Auth Layout - Basado en Sliced -->
<div class="min-h-screen" style="background-color: #f9fbfd; color: black; background-image: url('assets/images/bg-shape.png'); background-size: cover; background-repeat: no-repeat;">

    <!-- Header -->
    <header>
        <nav class="px-4 lg:px-7 py-4 max-w-[1440px] mx-auto">
      <div class="flex flex-wrap items-center justify-between">
       <a href="/" class="flex items-center">
      <img src="assets/images/logo-dark.svg" class="mx-auto dark-logo h-7 dark:hidden" alt="VRM Logo">
            <img src="assets/images/logo-light.svg" class="hidden mx-auto light-logo h-7 dark:block" alt="VRM Logo">
   </a>
    <div class="flex items-center lg:order-2">
<span class="text-sm text-gray-600">VRM Plugin Demo</span>
        </div>
            </div>
        </nav>
    </header>

    <!-- Body Content -->
  @Body

    <!-- Footer -->
    <footer class="py-5 text-center text-black dark:text-white/80 max-w-[1440px] mx-auto">
        <div>
          &copy;
            <span>@DateTime.Now.Year</span>
            VRM Plugin Demo.
            <span>
     Powered by
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4 inline-block relative -mt-[2px]">
                  <path d="M12.001 4.52853C14.35 2.42 17.98 2.49 20.2426 4.75736C22.5053 7.02472 22.583 10.637 20.4786 12.993L11.9999 21.485L3.52138 12.993C1.41705 10.637 1.49571 7.01901 3.75736 4.75736C6.02157 2.49315 9.64519 2.41687 12.001 4.52853Z" class="fill-purple"></path>
   </svg>
                Sliced Template
     </span>
        </div>
    </footer>
</div>
