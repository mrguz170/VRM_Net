    <!-- ✅ INTERCEPTOR GLOBAL DE ERRORES DE CIRCUIT -->
    <script>
        (function() {
            // Sobrescribir el método global de invocación de .NET
            if (window.DotNet && window.DotNet.invokeMethodAsync) {
                const originalInvokeMethodAsync = window.DotNet.invokeMethodAsync;

                window.DotNet.invokeMethodAsync = async function(...args) {
                    try {
                        return await originalInvokeMethodAsync.apply(this, args);
                    } catch (error) {
                        // Silenciar errores de circuit desechado
                        if (error.message && error.message.includes('circuit')) {
                            console.debug('[Circuit] Invocación ignorada - circuit desechado');
                            return null;
                        }
                        // Re-lanzar otros errores
                        throw error;
                    }
                };

                // console.log('[Circuit Guard] ✅ Interceptor global de circuit activado');
            }

            // También interceptar errores no capturados
            window.addEventListener('error', function(event) {
                if (event.error && event.error.message && event.error.message.includes('circuit')) {
                    console.debug('[Circuit] Error de circuit capturado y suprimido');
                    event.preventDefault();
                    return false;
                }
            });

            window.addEventListener('unhandledrejection', function(event) {
                if (event.reason && event.reason.message && event.reason.message.includes('circuit')) {
                    console.debug('[Circuit] Promise rejection de circuit capturado y suprimido');
                    event.preventDefault();
                    return false;
                }
            });
        })();
    </script>

    <!-- ✅ SOLUCIÓN: Cleanup automático de event listeners -->
    <script>
        window.addClickListener = function (dotNetObject) {
            // Definir el handler como función nombrada para poder removerlo
            const clickHandler = async function () {
                try {
                    // Verificar si el dotNetObject aún es válido antes de invocar
                    if (dotNetObject && dotNetObject._id !== undefined) {
                        await dotNetObject.invokeMethodAsync("HandleClickEvent");
                    }
                } catch (error) {
                    // Si falla, remover el listener automáticamente
                    if (error.message && error.message.includes('circuit')) {
                        console.debug('[Cleanup] Removiendo listener - circuit desechado');
                        document.body.removeEventListener("click", clickHandler);
                    } else {
                        console.error('[HandleClickEvent] Error:', error);
                    }
                }
            };

            document.body.addEventListener("click", clickHandler);

            // ✅ IMPORTANTE: Retornar objeto con método dispose para cleanup manual
            return {
                dispose: () => {
                    document.body.removeEventListener("click", clickHandler);
                    console.debug('[Cleanup] Listener removido manualmente');
                }
            };
        };
    </script>

