<!DOCTYPE html>
<html lang="en" :dir="$store.app.direction" x-data :data-mode="$store.app.mode" :data-sidebar="$store.app.sidebarMode" class="group/item">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- ==================== SLICED CSS ==================== -->
    <!-- Plugins CSS -->
    <link rel="stylesheet" href="assets/css/plugins.css">
    <!-- Icons CSS (Remix Icons) -->
    <link rel="stylesheet" href="assets/css/remixicon.css">
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="assets/css/tailwind.css">
    <!-- Custom Sliced Styles -->
    <link rel="stylesheet" href="assets/css/style.css">
    
    <!-- ==================== MUDBLAZOR CSS ==================== -->
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- ==================== APP CSS ==================== -->
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="VRM_Plugin.Blazor.Server.styles.css" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="favicon.png" />
    
    <!-- ==================== ALPINE.JS CORE & PLUGINS (EN HEAD) ==================== -->
    <!-- ✅ CRÍTICO: Cargar Alpine ANTES de que el DOM se procese -->
    <script src="assets/js/pages/alpine.min.js"></script>
    <script src="assets/js/pages/alpine-collaspe.min.js"></script>
  <script src="assets/js/pages/alpine-persist.min.js"></script>
    
    <!-- ✅ CRÍTICO: Registrar store 'app' ANTES de Alpine.start() -->
    <script src="assets/js/main.js"></script>
    <script src="assets/js/vrm-init.js"></script>
    
  <HeadOutlet />
</head>

<body x-data="main" :class="[$store.app.sidebar ? 'toggle-sidebar' : '', $store.app.layout]" class="relative overflow-x-hidden text-sm antialiased font-normal text-black font-cerebri dark:text-white vertical">
    <Routes />
    
    <!-- ==================== VERIFICACIÓN DE INICIALIZACIÓN ==================== -->
    <script>
      // Verificar que los stores estén registrados después de la inicialización
        setTimeout(() => {
          if (typeof Alpine !== 'undefined' && Alpine.store) {
       const appStore = Alpine.store('app');
       if (appStore) {
     console.log('✅ Store "app" registrado correctamente:', {
   mode: appStore.mode,
          sidebar: appStore.sidebar,
    direction: appStore.direction,
   sidebarMode: appStore.sidebarMode,
          layout: appStore.layout
      });
             } else {
         console.error('❌ Store "app" NO está registrado');
      }
            } else {
      console.error('❌ Alpine no está disponible');
  }
        }, 500);
    </script>

    <!-- ==================== BLAZOR FRAMEWORK ==================== -->
    <script src="_framework/blazor.web.js"></script>
    
    <!-- ==================== MUDBLAZOR JS ==================== -->
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    
    <!-- ==================== GLOBAL FUNCTIONS FOR BLAZOR ==================== -->
    <script>
        // ✅ FIX: Función segura para setAttribute (evita Illegal Invocation)
     function safeSetAttribute(element, name, value) {
            try {
     Element.prototype.setAttribute.call(element, name, value);
  } catch (error) {
                console.error('❌ Error al setear atributo ' + name + ':', error);
  element.setAttribute(name, value);
    }
        }
        
      // ✅ FIX CRÍTICO: Verificar que Alpine store esté disponible ANTES de usar toggleMode
function safeToggleMode(mode) {
       if (typeof Alpine === 'undefined' || !Alpine.store || !Alpine.store('app')) {
   console.warn('⚠️ Alpine store no disponible, reintentando en 100ms...');
    setTimeout(() => safeToggleMode(mode), 100);
       return;
         }
   
        const store = Alpine.store('app');
  if (typeof store.toggleMode === 'function') {
     store.toggleMode(mode);
   console.log('✅ toggleMode aplicado:', mode);
} else {
 console.error('❌ toggleMode no es una función en el store');
        }
    }
        
    // Funciones globales de JavaScript para Blazor
        window.toggleSidebar = function () {
 if (typeof Alpine !== 'undefined' && Alpine.store && Alpine.store('app')) {
             Alpine.store('app').toggleSidebar();
            }
   };
        
        window.toggleFullScreen = function () {
  if (typeof Alpine !== 'undefined' && Alpine.store && Alpine.store('app')) {
     Alpine.store('app').toggleFullScreen();
            }
        };

        window.changeDirection = function (direction) {
            if (typeof Alpine !== 'undefined' && Alpine.store && Alpine.store('app')) {
        Alpine.store('app').direction = direction;
          safeSetAttribute(document.documentElement, 'dir', direction);
     localStorage.setItem('_x_direction', direction);
         }
   };
        
        window.setBodyClass = function (mode) {
       safeToggleMode(mode); // ✅ Usar versión segura
        };
        
      // ✅ Forzar actualización de Alpine después de navegación Blazor
  window.refreshAlpineState = function() {
     console.log('🔄 refreshAlpineState llamado desde Blazor');
            
    try {
     if (typeof Alpine !== 'undefined' && Alpine.store && Alpine.store('app')) {
        const store = Alpine.store('app');
          
 // Leer valores de localStorage
         const savedMode = localStorage.getItem('_x_mode');
   const savedSidebarMode = localStorage.getItem('_x_sidebarMode');
           const savedLayout = localStorage.getItem('_x_layout');
           const savedDirection = localStorage.getItem('_x_direction');
         
     console.log('📖 Leyendo localStorage:', {
          mode: savedMode,
     sidebarMode: savedSidebarMode,
     layout: savedLayout,
        direction: savedDirection
});
        
          // Aplicar modo usando versión segura
       if (savedMode && store.mode !== savedMode) {
         console.log('  → Aplicando modo: ' + savedMode);
             safeToggleMode(savedMode);
       }
    
       // Aplicar sidebar mode
   if (savedSidebarMode && store.sidebarMode !== savedSidebarMode) {
             console.log('  → Aplicando sidebar mode: ' + savedSidebarMode);
        store.sidebarMode = savedSidebarMode;
         safeSetAttribute(document.documentElement, 'data-sidebar', savedSidebarMode);
    }
               
           // Aplicar layout
        if (savedLayout && store.layout !== savedLayout) {
          console.log('  → Aplicando layout: ' + savedLayout);
    store.layout = savedLayout;
 }
               
  // Aplicar dirección
                if (savedDirection && store.direction !== savedDirection) {
            console.log('  → Aplicando dirección: ' + savedDirection);
           store.direction = savedDirection;
            safeSetAttribute(document.documentElement, 'dir', savedDirection);
     }
 
                console.log('✅ Estado Alpine actualizado');
    } else {
          console.warn('⚠️ Alpine store no disponible');
    }
            } catch (error) {
    console.error('❌ Error en refreshAlpineState:', error);
     }
        };
        
 // ✅ Forzar modo dark/light programáticamente
        window.setDarkMode = function(isDark) {
            try {
      const mode = isDark ? 'dark' : 'light';
   safeToggleMode(mode); // ✅ Usar versión segura
    console.log('🌓 Modo forzado a: ' + mode);
            } catch (error) {
              console.error('❌ Error en setDarkMode:', error);
     }
        };
    
        // ✅ Escuchar eventos de navegación de Blazor
        Blazor.addEventListener('enhancedload', () => {
         console.log('🚀 Blazor enhancedload - Reaplicando modo...');
  
            if (typeof Alpine !== 'undefined' && Alpine.store && Alpine.store('app')) {
        const savedMode = localStorage.getItem('_x_mode');
          if (savedMode) {
     safeToggleMode(savedMode); // ✅ Usar versión segura
        }
            }
  });
    </script>
</body>
</html>
