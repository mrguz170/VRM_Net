{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Information",
        "System": "Error",
        "VRM_Plugin.Blazor.Server": "Information",
        "VRM_Plugin.Blazor.Server.Components.Layout.Sidebar": "Warning",
        "VRM_Plugin.Blazor.Server.Services": "Information",
        "VRM_Plugin.Modules": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/prod/vrm-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] [{MachineName}] [{EnvironmentName}] {Message:lj} {Properties}{NewLine}{Exception}",
          "fileSizeLimitBytes": 104857600,
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/prod/errors/vrm-errors-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 365,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] [{MachineName}] {Message:lj} {Properties}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Error"
        }
      }
    ]
  },
  "DetailedErrors": false
}
