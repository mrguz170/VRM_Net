<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Components\Shared\**" />
    <Content Remove="Components\Shared\**" />
    <EmbeddedResource Remove="Components\Shared\**" />
    <None Remove="Components\Shared\**" />
  </ItemGroup>

  <ItemGroup>
  
    <ProjectReference Include="..\..\Core\VRM_Plugin.Core.Abstractions\VRM_Plugin.Core.Abstractions.csproj" />
    <ProjectReference Include="..\..\Core\VRM_Plugin.Core.Shared\VRM_Plugin.Core.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    
    <PackageReference Include="MudBlazor" Version="8.15.0" />
    
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- 🔥 Target para copiar módulos durante BUILD -->
  <Target Name="CopyModulesOnBuild" AfterTargets="Build">
    <Message Text="🏗️ [BUILD] Descubriendo y compilando módulos..." Importance="high" />

    <PropertyGroup>
      <ModulesOutDir>$(OutDir)Modules\</ModulesOutDir>
      <SolutionDir>$(MSBuildProjectDirectory)\..\..\..\</SolutionDir>
      <ModulesSourceDir>$(SolutionDir)src\Modules\</ModulesSourceDir>
    </PropertyGroup>

    <!-- 📦 Buscar TODOS los .csproj en la carpeta Modules (recursivo) -->
    <ItemGroup>
      <ModuleProjects Include="$(ModulesSourceDir)**\*.csproj" />
    </ItemGroup>

    <Message Text="📦 Encontrados @(ModuleProjects-&gt;Count()) proyectos de módulos:" Importance="high" />
    <Message Text="   %(ModuleProjects.Identity)" Importance="high" />

    <!-- 🔨 Compilar todos los módulos encontrados -->
    <MSBuild Projects="@(ModuleProjects)" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform)" BuildInParallel="true" />

    <!-- 🧹 Limpiar carpeta Modules de salida -->
    <ItemGroup>
      <OldModuleFiles Include="$(ModulesOutDir)**\*.*" />
    </ItemGroup>
    <Delete Files="@(OldModuleFiles)" ContinueOnError="true" />
    <RemoveDir Directories="$(ModulesOutDir)" ContinueOnError="true" />
    <MakeDir Directories="$(ModulesOutDir)" />

    <!-- 📋 Buscar DLLs de módulos compilados (buscar específicamente VRM_Plugin.*.dll) -->
    <ItemGroup>
      <ModuleDlls Include="$(ModulesSourceDir)**\bin\$(Configuration)\net8.0\VRM_Plugin.*.dll" Exclude="$(ModulesSourceDir)**\bin\$(Configuration)\net8.0\VRM_Plugin.Core.*.dll" />
      <ModulePdbs Include="$(ModulesSourceDir)**\bin\$(Configuration)\net8.0\VRM_Plugin.*.pdb" Exclude="$(ModulesSourceDir)**\bin\$(Configuration)\net8.0\VRM_Plugin.Core.*.pdb" />
    </ItemGroup>

    <Message Text="📋 Archivos DLL encontrados para copiar:" Importance="high" />
    <Message Text="   %(ModuleDlls.Identity)" Importance="high" />

    <!-- 📦 Copiar DLLs a la carpeta Modules -->
    <Copy SourceFiles="@(ModuleDlls)" DestinationFolder="$(ModulesOutDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />

    <!-- 📦 Copiar PDBs (para debugging) -->
    <Copy SourceFiles="@(ModulePdbs)" DestinationFolder="$(ModulesOutDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />

    <Message Text="✅ @(ModuleDlls-&gt;Count()) módulos copiados a $(ModulesOutDir)" Importance="high" />
  </Target>

  <!-- 🔥 Target para copiar módulos durante PUBLISH -->
  <Target Name="CopyModulesOnPublish" AfterTargets="Publish">
    <Message Text="🚀 [PUBLISH] Copiando módulos a la salida de publicación..." Importance="high" />

    <PropertyGroup>
      <SolutionDir>$(MSBuildProjectDirectory)\..\..\..\</SolutionDir>
      <ModulesSourceDir>$(SolutionDir)src\Modules\</ModulesSourceDir>
      <PublishModulesDir>$(PublishDir)Modules\</PublishModulesDir>
    </PropertyGroup>

    <!-- 📦 Buscar TODOS los .csproj en la carpeta Modules (recursivo) -->
    <ItemGroup>
      <ModuleProjects Include="$(ModulesSourceDir)**\*.csproj" />
    </ItemGroup>

    <Message Text="📦 Compilando @(ModuleProjects-&gt;Count()) módulos para publicación..." Importance="high" />
    <Message Text="   %(ModuleProjects.Identity)" Importance="high" />

    <!-- 🔨 Compilar todos los módulos encontrados -->
    <MSBuild Projects="@(ModuleProjects)" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform)" BuildInParallel="true" />

    <!-- 📁 Crear carpeta Modules en la salida de publicación -->
    <RemoveDir Directories="$(PublishModulesDir)" ContinueOnError="true" />
    <MakeDir Directories="$(PublishModulesDir)" />

    <!-- 📋 Buscar DLLs de módulos compilados (buscar específicamente VRM_Plugin.*.dll) -->
    <ItemGroup>
      <PublishModuleDlls Include="$(ModulesSourceDir)**\bin\$(Configuration)\net8.0\VRM_Plugin.*.dll" Exclude="$(ModulesSourceDir)**\bin\$(Configuration)\net8.0\VRM_Plugin.Core.*.dll" />
      <PublishModulePdbs Include="$(ModulesSourceDir)**\bin\$(Configuration)\net8.0\VRM_Plugin.*.pdb" Exclude="$(ModulesSourceDir)**\bin\$(Configuration)\net8.0\VRM_Plugin.Core.*.pdb" />
    </ItemGroup>

    <Message Text="📋 Archivos DLL a copiar para publicación:" Importance="high" />
    <Message Text="   %(PublishModuleDlls.Identity)" Importance="high" />

    <!-- 📦 Copiar DLLs a la carpeta Modules de publicación -->
    <Copy SourceFiles="@(PublishModuleDlls)" DestinationFolder="$(PublishModulesDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />

    <!-- 📦 Copiar PDBs (para debugging) -->
    <Copy SourceFiles="@(PublishModulePdbs)" DestinationFolder="$(PublishModulesDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />

    <Message Text="✅ @(PublishModuleDlls-&gt;Count()) módulos copiados a $(PublishModulesDir)" Importance="high" />
  </Target>
  
</Project>
