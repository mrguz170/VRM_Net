@using System.Reflection
@using VRM_Plugin.Blazor.Server.Services
@using VRM_Plugin.Blazor.Server.Components.Layout
@using VRM_Plugin.Core.Abstractions.Services
@inject IServiceProvider ServiceProvider
@inject NavigationManager NavigationManager

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="@additionalAssemblies">
        <Found Context="routeData">
          @{
    // CRÍTICO: Login y Logout NO deben usar InteractiveServer para poder escribir cookies
   var isAuthPage = routeData.PageType == typeof(VRM_Plugin.Blazor.Server.Components.Pages.Login) ||
               routeData.PageType == typeof(VRM_Plugin.Blazor.Server.Components.Pages.Logout);
}
      
            @if (isAuthPage)
  {
         @* Páginas de autenticación SIN rendermode (SSR puro) *@
        <RouteView RouteData="@routeData" />
}
  else
     {
    @* Otras páginas CON InteractiveServer *@
     <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
     <NotAuthorized Context="authContext">
      @if (!(authContext.User?.Identity?.IsAuthenticated ?? false))
      {
     @* Usuario no autenticado → Redirigir a Login *@
<RedirectToLogin />
         }
    else
       {
       @* Usuario autenticado pero sin permisos *@
        <div class="flex items-center justify-center min-h-screen bg-gray-100">
          <div class="max-w-md p-8 bg-white rounded-lg shadow-lg">
  <h1 class="text-2xl font-bold text-red-600 mb-4">Access Denied</h1>
   <p class="text-gray-700 mb-4">You don't have permission to access this page.</p>
              <a href="/" class="btn bg-purple text-white px-4 py-2 rounded">Go to Home</a>
 </div>
         </div>
         }
        </NotAuthorized>
     </AuthorizeRouteView>
   }
</Found>
<NotFound>
  <PageTitle>Not Found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
  <div class="flex items-center justify-center min-h-screen bg-gray-100">
    <div class="max-w-md p-8 bg-white rounded-lg shadow-lg">
     <h1 class="text-2xl font-bold text-gray-800 mb-4">404 - Page Not Found</h1>
      <p class="text-gray-600 mb-4">The page you're looking for doesn't exist.</p>
    <a href="/" class="btn bg-purple text-white px-4 py-2 rounded">Go to Home</a>
        </div>
    </div>
        </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private Assembly[]? additionalAssemblies;

    protected override void OnInitialized()
    {
      // Obtener módulos cargados dinámicamente
 var moduleManager = ServiceProvider.GetService<IModuleManager>();
        
        if (moduleManager != null)
        {
      var modules = moduleManager.GetAllModules();
   additionalAssemblies = modules
  .Select(m => m.GetType().Assembly)
 .Distinct()
         .ToArray();
        }
    else
      {
   additionalAssemblies = Array.Empty<Assembly>();
        }
    }
}