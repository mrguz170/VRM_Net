@page "/paneladmin/roles"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PanelAdminModule CurrentModule
@inject IRolService RolService

<CascadingValue Value="@CurrentModule" Name="CurrentModule">
    <div class="container mt-5">
        <div class="row mb-4">
            <div class="col-md-8">
                <h2>Gestión de Roles</h2>
            </div>
        </div>  

        @if (isLoading)
        {
            <div class="alert alert-info">
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                Cargando roles...
            </div>
        }
        else if (roles != null && roles.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th>Fecha de Creación</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rol in roles)
                        {
                            <tr>
                                <td>@rol.role_id</td>
                                <td>
                                    <strong>@rol.role_name</strong>
                                </td>
                                <td>@rol.description</td>
                                <td>
                                    @if (rol.is_active)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td>@rol.created_date.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => EditarRol(rol)">
                                        Editar
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => EliminarRol(rol)">
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (!isLoading && (roles == null || !roles.Any()))
        {
            <div class="alert alert-warning">
                No hay roles disponibles en el sistema.
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }
    </div>
</CascadingValue>

@code {
    private List<RolDto>? roles;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            
            // Cargar todos los roles
            roles = await RolService.GetAllAsync();
            

        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar los roles. Por favor, intente nuevamente.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void EditarRol(RolDto rol)
    {
        // TODO: Implementar lógica de edición
    }

    private async Task EliminarRol(RolDto rol)
    {
        // TODO: Implementar lógica de eliminación
    }
}
