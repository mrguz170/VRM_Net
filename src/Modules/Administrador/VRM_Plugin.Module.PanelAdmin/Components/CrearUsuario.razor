@page "/paneladmin/CrearUsuario"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PanelAdminModule CurrentModule

<CascadingValue Value="@CurrentModule" Name="CurrentModule">
    
<div class="flex flex-col gap-4 min-h-[calc(100vh-212px)]">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="card">
            <MudText Typo="Typo.h2" Class="mb-4 text-base font-semibold capitalize text-slate-800 dark:text-slate-100">Profile Details</MudText>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="space-y-2">
                    <MudText>First Name</MudText>
                    <input type="text" class="form-input" placeholder="First Name" value="Stevens" required="">
@*                     <MudTextField  @bind-Value="FirstName" Label="First Name" Placeholder="First Name" Required="true" Immediate="true" />
 *@
                </div>
                <div class="space-y-2">
                    <MudText>Last Name</MudText>
                    <input type="text" class="form-input" placeholder="Last Name" value="Laurie" required="">
                </div>
                <div class="space-y-2 md:col-span-2">
                    <MudText>Username</MudText>
                    <input type="text" class="form-input" placeholder="username" value="Stevens_Laurie" required="">
                </div>
                <div class="space-y-2 md:col-span-2">
                    <MudText>Your email</MudText>
                    <input type="email" class="form-input" placeholder="Email" value="example@example.com" required="">
                </div>
                @* <div class="space-y-2 md:col-span-2">
                    <MudText>Profession</MudText>
                    <input type="text" class="form-input" placeholder="Profession" value="Ui/Ux Designer" required="">
                </div> *@
                @* <div class="space-y-2 md:col-span-2">
                    <MudText>Location</MudText>
                    <input type="text" class="form-input" placeholder="Location" value="Canada" required="">
                </div>
                <div class="space-y-2 md:col-span-2">
                    <MudText>Website</MudText>
                    <input type="text" class="form-input" placeholder="Website" value="websiteexample.com" required="">
                </div>
                <div class="space-y-2 md:col-span-2">
                    <MudText>Phone</MudText>
                    <input type="phone" class="form-input" placeholder="Phone" value=" +123 45678 789" required="">
                </div> *@
                <div class="flex flex-wrap gap-3">
                    <MudButton type="button" Class="btn bg-purple border-purple text-white hover:bg-purple/[0.85] hover:border-purple/[0.85]">Save</MudButton>
                    <MudButton type="button" Class="btn bg-light border-light text-black hover:bg-light/[0.85] hover:border-light/[0.85]">Discard</MudButton>
                </div>
            </div>
        </div>
     </div>
</div>

</CascadingValue>

@code {
    // Servicio inyectable (descomenta si lo registras en ConfigureServices)
    // @inject IUsuarioService UsuarioService

    protected override async Task OnInitializedAsync()
    {
        await Task.CompletedTask;
    }
}
