@page "/finanzas/facturas"
[Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using VRM_Plugin.Modules.Finanzas.Services
@using VRM_Plugin.Modules.Finanzas.Domain
@using VRM_Plugin.Core.Abstractions
@inject FinanzasModule CurrentModule

@* <PageTitle>Facturas - Prueba de AuthorizeAction</PageTitle> *@

<CascadingValue Value="@CurrentModule" Name="CurrentModule">

    <PageHeader Title="@CurrentModule.DisplayName" pTitle="Facturas"></PageHeader>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1>?? Prueba de AuthorizeAction</h1>
            <p class="text-muted">Validación de permisos mediante Action Keys desde Base de Datos</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5>Botones de Prueba - Action Keys</h5>
        </div>
        <div class="card-body">
            <div class="d-flex gap-2 flex-wrap">
                <!-- ? PRUEBA 1: Nueva Factura -->
                <AuthorizeAction Action="Finanzas.Facturas.Nueva">
                    <button class="btn btn-primary">
                        <i class="ri-add-line"></i> Nueva Factura
                        <small class="d-block">Action: Finanzas.Facturas.Nueva</small>
                    </button>
                </AuthorizeAction>

                <!-- ? PRUEBA 2: Editar Factura -->
                <AuthorizeAction Action="Finanzas.Facturas.Editar">
                    <button class="btn btn-warning">
                        <i class="ri-edit-line"></i> Editar Factura
                        <small class="d-block">Action: Finanzas.Facturas.Editar</small>
                    </button>
                </AuthorizeAction>

                <!-- ? PRUEBA 3: Timbrar SAT -->
                <AuthorizeAction Action="Finanzas.Facturas.TimbrarSAT">
                    <button class="btn btn-success">
                        <i class="ri-check-double-line"></i> Timbrar SAT
                        <small class="d-block">Action: Finanzas.Facturas.TimbrarSAT</small>
                    </button>
                </AuthorizeAction>

                <!-- ? PRUEBA 4: Eliminar Factura -->
                <AuthorizeAction Action="Finanzas.Facturas.Eliminar">
                    <button class="btn btn-danger">
                        <i class="ri-delete-bin-line"></i> Eliminar Factura
                        <small class="d-block">Action: Finanzas.Facturas.Eliminar</small>
                    </button>
                </AuthorizeAction>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header bg-info text-white">
            <h5>?? Información de Permisos</h5>
        </div>
        <div class="card-body">
            <p><strong>Módulo Actual:</strong> @CurrentModule.ModuleName</p>
            <p><strong>Total Acciones Cargadas:</strong> @CurrentModule.GetActions().Count</p>
            
            <h6 class="mt-3">Acciones del Módulo:</h6>
            <ul class="list-group">
                @foreach (var action in CurrentModule.GetActions().Where(a => a.ActionKey.Contains("Facturas")))
                {
                    <li class="list-group-item">
                        <strong>@action.ActionKey</strong>
                        <br>
                        <small class="text-muted">Permisos requeridos (IDs): @string.Join(", ", action.RequiredPermissionIds)</small>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
</CascadingValue>

