@page "/finanzas"
@rendermode InteractiveServer
@namespace VRM_Plugin.Modules.Finanzas.Components
@using Microsoft.AspNetCore.Components.Authorization
@using VRM_Plugin.Modules.Finanzas.Services
@using VRM_Plugin.Modules.Finanzas.Domain
@inject IFacturaService FacturaService
@inject IPagoService PagoService

<PageTitle>Gestión de Finanzas</PageTitle>

@* ✅ Proteger TODO el módulo con AuthorizeModule *@
<AuthorizeModule ModuleId="Finanzas">

<h1>💰 Gestión de Finanzas</h1>

<div class="alert alert-info mt-4">
    <h4>Módulo de Finanzas</h4>
    <p>Este módulo permite gestionar:</p>
    <ul>
        <li>📄 Facturas</li>
      <li>💳 Pagos</li>
        <li>🏦 Conciliaciones bancarias</li>
        <li>📊 Cuentas por pagar</li>
    </ul>
</div>

<div class="card mt-3">
    <div class="card-header bg-primary text-white">
  <h5>📊 Estadísticas Financieras</h5>
    </div>
    <div class="card-body">
    <div class="row">
        <div class="col-md-3">
       <div class="card bg-success text-white">
            <div class="card-body">
              <h6>Facturas Pagadas</h6>
        <h3>@facturasPagadas</h3>
          </div>
                </div>
       </div>
<div class="col-md-3">
                <div class="card bg-warning text-white">
         <div class="card-body">
     <h6>Facturas Pendientes</h6>
              <h3>@facturasPendientes</h3>
         </div>
    </div>
       </div>
   <div class="col-md-3">
    <div class="card bg-info text-white">
     <div class="card-body">
  <h6>Total Ingresos</h6>
    <h3>$@totalIngresos.ToString("N0")</h3>
         </div>
 </div>
            </div>
<div class="col-md-3">
     <div class="card bg-danger text-white">
           <div class="card-body">
             <h6>Facturas Vencidas</h6>
      <h3>@facturasVencidas</h3>
      </div>
        </div>
    </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
 <h5 class="mb-0">📋 Últimas Facturas</h5>
        
        @* Botón crear - Gerentes y coordinadores *@
        <AuthorizeView Roles="Admin,GerenteFinanzas,CoordinadorFinanzas">
<Authorized>
        <button class="btn btn-primary btn-sm" @onclick="CrearFactura">
     <span class="bi bi-plus-circle"></span> Nueva Factura
            </button>
     </Authorized>
     </AuthorizeView>
    </div>
    <div class="card-body">
     @if (facturas == null)
        {
            <p><em>Cargando facturas...</em></p>
      }
        else if (!facturas.Any())
        {
        <p>No hay facturas registradas.</p>
        }
        else
  {
   <table class="table table-striped">
  <thead>
                    <tr>
                <th>Número</th>
   <th>Cliente</th>
      <th>Fecha Emisión</th>
<th>Total</th>
    <th>Estado</th>
                     <th>Acciones</th>
        </tr>
     </thead>
      <tbody>
            @foreach (var factura in facturas)
         {
          <tr>
            <td>@factura.Numero</td>
     <td>@factura.NombreCliente</td>
           <td>@factura.FechaEmision.ToString("dd/MM/yyyy")</td>
       <td>$@factura.Total.ToString("N2")</td>
       <td>
       <span class="badge @GetEstadoBadgeClass(factura.Estado)">
   @factura.Estado.ToString()
   </span>
     </td>
   <td>
    <div class="btn-group btn-group-sm" role="group">
  @* Ver - Todos *@
     <AuthorizeView Roles="Admin,GerenteFinanzas,CoordinadorFinanzas,Contador">
         <Authorized>
    <button class="btn btn-outline-info" title="Ver detalles">
            <span class="bi bi-eye"></span>
            </button>
          </Authorized>
    </AuthorizeView>
    
     @* Editar - Gerentes y coordinadores *@
        <AuthorizeView Roles="Admin,GerenteFinanzas,CoordinadorFinanzas">
        <Authorized>
          <button class="btn btn-outline-warning" title="Editar">
           <span class="bi bi-pencil"></span>
           </button>
      </Authorized>
           </AuthorizeView>
            
  @* ⭐ TIMBRAR SAT - SOLO GERENTES - Usa AuthorizeAction *@
       <AuthorizeAction Action="Finanzas.Facturas.TimbrarSAT">
       <button class="btn btn-success" 
         @onclick="() => TimbrarFactura(factura.Id)"
              disabled="@(factura.Estado != EstadoFactura.Pendiente)"
           title="Timbrar en SAT (Solo Gerente)">
         <span class="bi bi-check-circle"></span> SAT
    </button>
   </AuthorizeAction>
         
           @* Eliminar - Solo gerentes *@
   <AuthorizeAction Action="Finanzas.Facturas.Eliminar">
             <button class="btn btn-outline-danger" title="Eliminar">
       <span class="bi bi-trash"></span>
        </button>
         </AuthorizeAction>
     </div>
         </td>
      </tr>
        }
          </tbody>
         </table>
  }
    </div>
</div>

@* ⭐ SECCIÓN DE REPORTES SENSIBLES - SOLO GERENTES con AuthorizeAction *@
<AuthorizeAction Action="Finanzas.Reportes.VerSensibles">
    <div class="card mt-3 border-danger">
        <div class="card-header bg-danger text-white">
          <h5 class="mb-0">🔒 Reportes Confidenciales (Solo Gerente)</h5>
   </div>
        <div class="card-body">
          <p>Información financiera confidencial disponible solo para gerentes de finanzas.</p>
            <div class="btn-group">
            <button class="btn btn-light">
   <span class="bi bi-file-earmark-pdf"></span> Reporte de Utilidades
          </button>
       <button class="btn btn-light">
   <span class="bi bi-file-earmark-excel"></span> Flujo de Efectivo Detallado
           </button>
     
       @* Exportar reportes sensibles - Acción aún más restringida *@
                <AuthorizeAction Action="Finanzas.Reportes.ExportarSensibles">
         <button class="btn btn-warning">
      <span class="bi bi-download"></span> Exportar Todo
          </button>
       </AuthorizeAction>
     </div>
      </div>
    </div>
</AuthorizeAction>

@* Sección de reportes generales - Todos pueden ver *@
<AuthorizeAction Action="Finanzas.Reportes.VerGenerales">
    <div class="card mt-3">
        <div class="card-header">
            <h5 class="mb-0">📊 Reportes Generales</h5>
     </div>
        <div class="card-body">
    <p>Reportes disponibles para todo el equipo de finanzas.</p>
     <button class="btn btn-primary btn-sm">
        <span class="bi bi-file-earmark-bar-graph"></span> Resumen Mensual
            </button>
  <button class="btn btn-primary btn-sm">
       <span class="bi bi-file-earmark-text"></span> Estado de Cuenta
  </button>
        </div>
    </div>
</AuthorizeAction>

</AuthorizeModule>

@code {
    private List<Factura>? facturas;
    private int facturasPagadas = 0;
    private int facturasPendientes = 0;
    private decimal totalIngresos = 0;
    private int facturasVencidas = 0;

 protected override async Task OnInitializedAsync()
    {
   // Cargar facturas desde el servicio
      facturas = await FacturaService.GetFacturasAsync();
      
   // Calcular estadísticas
        facturasPagadas = facturas.Count(f => f.Estado == EstadoFactura.Pagada);
        facturasPendientes = facturas.Count(f => f.Estado == EstadoFactura.Pendiente);
        facturasVencidas = facturas.Count(f => f.Estado == EstadoFactura.Vencida);
   totalIngresos = facturas.Where(f => f.Estado == EstadoFactura.Pagada).Sum(f => f.Total);
    }
  
    private string GetEstadoBadgeClass(EstadoFactura estado)
    {
        return estado switch
        {
       EstadoFactura.Pagada => "bg-success",
  EstadoFactura.Pendiente => "bg-warning",
     EstadoFactura.Vencida => "bg-danger",
   EstadoFactura.Cancelada => "bg-secondary",
     EstadoFactura.PagoParcial => "bg-info",
      _ => "bg-light text-dark"
      };
    }
    
    private void CrearFactura()
    {
        // TODO: Implementar navegación a formulario de creación
        Console.WriteLine("Navegando a crear factura...");
    }
    
    private async Task TimbrarFactura(int facturaId)
    {
        // ⭐ ACCIÓN CRÍTICA - Solo gerentes pueden ejecutar
        Console.WriteLine($"✅ Timbrando factura {facturaId} en SAT...");
        
        // TODO: Implementar lógica real de timbrado
        // await FacturaService.TimbrarEnSATAsync(facturaId);
        
        await Task.CompletedTask;
    }
}
