@page "/finanzas/facturas"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Facturas</PageTitle>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="text-2xl font-bold text-gray-800 dark:text-white">
                <i class="ri-file-list-3-line mr-2"></i>
                Gestión de Facturas
            </h1>
            <p class="text-gray-600 dark:text-gray-400">
                Administra las facturas del sistema (emitidas y recibidas)
            </p>
        </div>
    </div>

    <!-- Filtros y Acciones -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <input type="text" 
                           class="form-control" 
                           placeholder="Buscar por número, RFC o cliente..." 
                           @bind="_searchTerm"
                           @bind:event="oninput"
                           @onkeyup="OnSearchChanged">
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="_filterEstado" @bind:after="AplicarFiltros">
                        <option value="">Todos los estados</option>
                        <option value="Borrador">Borrador</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Timbrada">Timbrada</option>
                        <option value="Pagada">Pagada</option>
                        <option value="Cancelada">Cancelada</option>
                        <option value="Vencida">Vencida</option>
                    </select>
                </div>
                <div class="col-md-3 text-end">
                    <!-- ? ACCIÓN: Crear Factura - Admin, Gerente, Coordinador -->
                    <AuthorizeView Roles="Admin,GerenteFinanzas,CoordinadorFinanzas">
                        <Authorized>
                            <button class="btn btn-primary" @onclick="AbrirModalCrear">
                                <i class="ri-add-line mr-1"></i>
                                Nueva Factura
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Facturas -->
    <div class="card">
        <div class="card-body">
            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2 text-muted">Cargando facturas...</p>
                </div>
            }
            else if (!_facturasFiltradas.Any())
            {
                <div class="alert alert-info">
                    <i class="ri-information-line mr-2"></i>
                    No se encontraron facturas con los filtros aplicados.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Número</th>
                                <th>Cliente</th>
                                <th>RFC</th>
                                <th>Fecha Emisión</th>
                                <th>Vencimiento</th>
                                <th class="text-end">Total</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var factura in _facturasFiltradas)
                            {
                                <tr>
                                    <td>
                                        <strong>@factura.Numero</strong>
                                    </td>
                                    <td>@factura.NombreCliente</td>
                                    <td>
                                        <code class="text-sm">@factura.RfcCliente</code>
                                    </td>
                                    <td>@factura.FechaEmision.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (factura.FechaVencimiento.HasValue)
                                        {
                                            <span class="@GetVencimientoClass(factura.FechaVencimiento.Value)">
                                                @factura.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <strong>@factura.Total.ToString("C2")</strong>
                                    </td>
                                    <td>
                                        <span class="badge @GetEstadoBadgeClass(factura.Estado)">
                                            @factura.Estado
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <!-- ? ACCIÓN: Editar Factura (Admin, Gerente, Coordinador) -->
                                            <AuthorizeView Roles="Admin,GerenteFinanzas,CoordinadorFinanzas">
                                                <Authorized>
                                                    <button class="btn btn-outline-primary" 
                                                            title="Editar"
                                                            @onclick="() => AbrirModalEditar(factura)">
                                                        <i class="ri-edit-line"></i>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>

                                            <!-- ? ACCIÓN: Timbrar SAT (Solo Admin y Gerente) -->
                                            @if (factura.Estado == EstadoFactura.Borrador || factura.Estado == EstadoFactura.Pendiente)
                                            {
                                                <AuthorizeView Roles="Admin,GerenteFinanzas">
                                                    <Authorized>
                                                        <button class="btn btn-outline-success" 
                                                                title="Timbrar en SAT (Solo Gerente)"
                                                                @onclick="() => TimbrarFactura(factura)">
                                                            <i class="ri-check-double-line"></i>
                                                        </button>
                                                    </Authorized>
                                                </AuthorizeView>
                                            }

                                            <!-- ? ACCIÓN: Cancelar Timbrada (Solo Admin y Gerente) -->
                                            @if (factura.Estado == EstadoFactura.Timbrada || factura.Estado == EstadoFactura.Pagada)
                                            {
                                                <AuthorizeView Roles="Admin,GerenteFinanzas">
                                                    <Authorized>
                                                        <button class="btn btn-outline-warning" 
                                                                title="Cancelar en SAT (Solo Gerente)"
                                                                @onclick="() => CancelarFacturaTimbrada(factura)">
                                                            <i class="ri-close-circle-line"></i>
                                                        </button>
                                                    </Authorized>
                                                </AuthorizeView>
                                            }

                                            <!-- ? ACCIÓN: Eliminar Factura (Solo Admin y Gerente) -->
                                            @if (factura.Estado == EstadoFactura.Borrador)
                                            {
                                                <AuthorizeView Roles="Admin,GerenteFinanzas">
                                                    <Authorized>
                                                        <button class="btn btn-outline-danger" 
                                                                title="Eliminar (Solo Gerente)"
                                                                @onclick="() => EliminarFactura(factura)">
                                                            <i class="ri-delete-bin-line"></i>
                                                        </button>
                                                    </Authorized>
                                                </AuthorizeView>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                <div class="row mt-3">
                    <div class="col-md-6">
                        <p class="text-muted">
                            Mostrando @_facturasFiltradas.Count de @_facturas.Count facturas
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h6 class="text-uppercase mb-1">Total Facturas</h6>
                    <h3 class="mb-0">@_facturas.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h6 class="text-uppercase mb-1">Timbradas</h6>
                    <h3 class="mb-0">@_facturas.Count(f => f.Estado == EstadoFactura.Timbrada)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <h6 class="text-uppercase mb-1">Pendientes</h6>
                    <h3 class="mb-0">@_facturas.Count(f => f.Estado == EstadoFactura.Borrador || f.Estado == EstadoFactura.Pendiente)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h6 class="text-uppercase mb-1">Total Facturado</h6>
                    <h3 class="mb-0">@_facturas.Sum(f => f.Total).ToString("C2")</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear/Editar -->
@if (_mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(_facturaEnEdicion?.Id > 0 ? "Editar Factura" : "Nueva Factura")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">Formulario de factura (implementar según necesidad)</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarFactura">
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // ==================== DATOS ====================
    private List<Factura> _facturas = new();
    private List<Factura> _facturasFiltradas = new();
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private string _filterEstado = string.Empty;
    private bool _mostrarModal = false;
    private Factura? _facturaEnEdicion = null;

    // ==================== INICIALIZACIÓN ====================
    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        CargarDatosEjemplo();
        _facturasFiltradas = _facturas;
        _isLoading = false;
    }

    // ==================== DATOS DE EJEMPLO ====================
    private void CargarDatosEjemplo()
    {
        _facturas = new List<Factura>
        {
            new Factura { Id = 1, Numero = "FAC-2025-001", FechaEmision = DateTime.Now.AddDays(-30), FechaVencimiento = DateTime.Now.AddDays(-15), RfcCliente = "ABC123456789", NombreCliente = "Empresa Demo S.A. de C.V.", Subtotal = 10000m, Impuestos = 1600m, Total = 11600m, Estado = EstadoFactura.Timbrada, CreadoPor = "admin" },
            new Factura { Id = 2, Numero = "FAC-2025-002", FechaEmision = DateTime.Now.AddDays(-15), FechaVencimiento = DateTime.Now.AddDays(15), RfcCliente = "XYZ987654321", NombreCliente = "Cliente Ejemplo S.A.", Subtotal = 25000m, Impuestos = 4000m, Total = 29000m, Estado = EstadoFactura.Pagada, CreadoPor = "admin" },
            new Factura { Id = 3, Numero = "FAC-2025-003", FechaEmision = DateTime.Now.AddDays(-5), FechaVencimiento = DateTime.Now.AddDays(25), RfcCliente = "DEF456789123", NombreCliente = "Corporativo Test S.A.", Subtotal = 50000m, Impuestos = 8000m, Total = 58000m, Estado = EstadoFactura.Borrador, CreadoPor = "admin" },
            new Factura { Id = 4, Numero = "FAC-2025-004", FechaEmision = DateTime.Now.AddDays(-60), FechaVencimiento = DateTime.Now.AddDays(-30), RfcCliente = "GHI789123456", NombreCliente = "Servicios Integrados S.A.", Subtotal = 15000m, Impuestos = 2400m, Total = 17400m, Estado = EstadoFactura.Vencida, CreadoPor = "admin" },
            new Factura { Id = 5, Numero = "FAC-2025-005", FechaEmision = DateTime.Now.AddDays(-10), FechaVencimiento = null, RfcCliente = "JKL321654987", NombreCliente = "Distribuidora Nacional S.A.", Subtotal = 35000m, Impuestos = 5600m, Total = 40600m, Estado = EstadoFactura.Cancelada, CreadoPor = "admin" }
        };
    }

    // ==================== FILTROS ====================
    private void OnSearchChanged()
    {
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        _facturasFiltradas = _facturas.Where(f =>
            (string.IsNullOrEmpty(_searchTerm) ||
             f.Numero.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
             f.NombreCliente.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
             f.RfcCliente.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_filterEstado) || f.Estado.ToString() == _filterEstado)
        ).ToList();
    }

    // ==================== ACCIONES ====================
    
    private void AbrirModalCrear()
    {
        _facturaEnEdicion = new Factura { FechaEmision = DateTime.Now, Estado = EstadoFactura.Borrador, CreadoPor = "admin" };
        _mostrarModal = true;
    }

    private void AbrirModalEditar(Factura factura)
    {
        _facturaEnEdicion = factura;
        _mostrarModal = true;
    }

    private void CerrarModal()
    {
        _mostrarModal = false;
        _facturaEnEdicion = null;
    }

    private async Task GuardarFactura()
    {
        await Task.Delay(500);
        CerrarModal();
    }

    private async Task EliminarFactura(Factura factura)
    {
        _facturas.Remove(factura);
        AplicarFiltros();
        await Task.CompletedTask;
    }

    private async Task TimbrarFactura(Factura factura)
    {
        await Task.Delay(1000);
        factura.Estado = EstadoFactura.Timbrada;
        StateHasChanged();
    }

    private async Task CancelarFacturaTimbrada(Factura factura)
    {
        await Task.Delay(1000);
        factura.Estado = EstadoFactura.Cancelada;
        StateHasChanged();
    }

    // ==================== HELPERS ====================
    
    private string GetEstadoBadgeClass(EstadoFactura estado)
    {
        return estado switch
        {
            EstadoFactura.Borrador => "bg-secondary",
            EstadoFactura.Pendiente => "bg-info",
            EstadoFactura.Timbrada => "bg-success",
            EstadoFactura.Pagada => "bg-primary",
            EstadoFactura.Cancelada => "bg-danger",
            EstadoFactura.Vencida => "bg-warning",
            _ => "bg-secondary"
        };
    }

    private string GetVencimientoClass(DateTime vencimiento)
    {
        var diasRestantes = (vencimiento - DateTime.Now).Days;
        if (diasRestantes < 0) return "text-danger fw-bold";
        if (diasRestantes <= 7) return "text-warning fw-bold";
        return "text-muted";
    }
}
