@using VRM_PluginDemo.Blazor.Server.Services
@inject IModuleManager ModuleManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">VRM Plugin Demo</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <!-- Enlaces estáticos -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="modules">
                <span class="bi bi-plug-fill" aria-hidden="true"></span> Módulos Cargados
            </NavLink>
        </div>

        <!-- Separador -->
        <hr class="my-2" />

        <!-- Enlaces dinámicos de módulos -->
        @foreach (var module in ModuleManager.GetAllModules())
        {
            foreach (var component in module.GetComponents().Where(c => c.ShowInMenu).OrderBy(c => c.MenuOrder))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@component.Route">
                        <span class="@component.Icon" aria-hidden="true"></span> @component.Name
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>