    Host[VRM_PluginDemo.Blazor.Server<br/>Host Application]
    
    Core[VRM_PluginDemo.Core.Abstractions<br/>IModule Interface]
    Domain[VRM_PluginDemo.Core.Domain<br/>Shared Entities]
    
    ModuleLoader[ModuleLoader Service<br/>Dynamic Assembly Loading]
    
